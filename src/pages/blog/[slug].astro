---
import BaseLayout from "../../layouts/BaseLayouts.astro";
import Nav from "../../components/Nav.astro";

export async function getStaticPaths() {
  const posts = import.meta.glob("../../content/blog/*.md", { eager: true }) as Record<
    string,
    {
      frontmatter: {
        title: string;
        date: string | Date;
      };
      file: string;
      default: any;
    }
  >;
  
  return Object.values(posts).map((post) => {
    const slug = post.file.split('/').pop()?.replace(/\.md$/, '') ?? '';
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const Content = post.default;
---

<BaseLayout title={post.frontmatter.title}>
  <Nav />
  
  <article class="post-content">
    <header>
      <h1>{post.frontmatter.title}</h1>
      <p class="date">
        {new Date(post.frontmatter.date).toLocaleDateString("pt-BR", { 
          day: "2-digit", month: "short", year: "numeric" 
        })}
      </p>
      <canvas id="confetti-canvas" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;"></canvas>
    </header>

    <Content />
    
    <div id="progress-bar"></div>
  </article>
</BaseLayout>

<style is:global>
  .post-content header {
    margin-bottom: 32px;
  }
  .post-content h1 {
    font-size: clamp(26px, 5vw, 32px);
    margin-bottom: 8px;
    line-height: 1.2;
    word-wrap: break-word;
  }
  .post-content .date {
    color: var(--color-muted);
    font-size: 14px;
  }
  .post-content img {
    margin-bottom: 16px;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .post-content pre {
    max-width: 100%;
    overflow-x: auto;
    padding: 16px;
    border-radius: 8px;
    font-size: 14px;
  }
  .post-content {
    max-width: 680px;
    margin: 0 auto;
    padding: 40px 24px; 
    width: 100%;
  }

  .post-content p {
    font-size: 16px;
    margin: 24px 0 16px;
    line-height: 1.6;
    text-align: justify; /* Força o alinhamento justificado do texto */
  }

  @media (max-width: 600px) {
    .post-content {
      padding: 24px 24px;
    }
    .post-content p {
      font-size: 15px;
    }
  }

#progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 4px;
    background: #0071e3; /* <-- Colocamos a cor exata aqui direto, sem variável! */
    z-index: 9999;
    transition: width 0.1s ease-out;
  }
</style>

<script is:inline>
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    
    // Se a página for curta e não tiver scroll, evita que a barra quebre
    if (height <= 0) return; 

    const scrolled = (winScroll / height) * 100;
    const progressBar = document.getElementById('progress-bar');
    if (progressBar) {
      progressBar.style.width = scrolled + '%';
    }
  });
</script>